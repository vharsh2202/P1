# P1 - Local Analytics API (environment configuration)
#
# Copy this file to `.env` (or export the variables in your shell) and adjust
# as needed. Every value below is the built-in default, so the app runs with
# no configuration at all.
#
# PowerShell example:
#   $env:P1_INTENT_THRESHOLD = "0.40"
#   .\.venv\Scripts\python.exe -m uvicorn main:app --port 8000

# ---------------------------------------------------------------------------
# Semantic router
# ---------------------------------------------------------------------------

# Cosine similarity floor. Lower = broader coverage / more false positives.
# Raise toward 0.55 if unrelated questions are being answered.
P1_INTENT_THRESHOLD=0.42

# If the runner-up intent scores within this margin of the winner, the
# question is treated as ambiguous and the user is asked to disambiguate.
P1_INTENT_AMBIGUITY_MARGIN=0.05

# If the out-of-scope (negative) class scores within this margin of the best
# intent, the question is rejected instead of answered.
P1_SCOPE_MARGIN=0.03

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------

# Any sentence-transformers model that outputs normalised embeddings works.
P1_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# cpu | cuda | mps  (cpu is the default; the model runs fine on CPU)
P1_EMBEDDING_DEVICE=cpu

# ---------------------------------------------------------------------------
# Warehouse
# ---------------------------------------------------------------------------

# Directory containing sales.csv and customers.csv.
# Defaults to ./data relative to main.py
# P1_DATA_DIR=./data

# Maximum rows returned to the client for a single query.
P1_RESULT_ROW_CAP=500

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------

# Comma-separated list of allowed origins. A regex additionally permits any
# localhost port, so the Vite dev server works on any port by default.
P1_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
